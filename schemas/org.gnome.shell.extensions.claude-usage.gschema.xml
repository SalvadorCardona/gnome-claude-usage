<?xml version="1.0" encoding="UTF-8"?>
<schemalist gettext-domain="claude-usage">
  <enum id="org.gnome.shell.extensions.claude-usage.metric">
    <value value="0" nick="session"/>
    <value value="1" nick="week"/>
    <value value="2" nick="model"/>
    <value value="3" nick="max"/>
  </enum>
  <schema id="org.gnome.shell.extensions.claude-usage"
          path="/org/gnome/shell/extensions/claude-usage/">
    <key name="refresh-interval" type="i">
      <default>300</default>
      <range min="60" max="3600"/>
      <summary>Refresh interval</summary>
      <description>Seconds between two readings of “claude -p /usage”.</description>
    </key>
    <key name="panel-metric" enum="org.gnome.shell.extensions.claude-usage.metric">
      <default>'session'</default>
      <summary>Metric shown in the top bar</summary>
      <description>Which limit the top bar pie stands for.</description>
    </key>
    <key name="show-percentage" type="b">
      <default>true</default>
      <summary>Show the percentage</summary>
      <description>Shows the value as a number next to the pie.</description>
    </key>
    <key name="claude-path" type="s">
      <default>''</default>
      <summary>Path to the claude binary</summary>
      <description>Leave empty to detect it automatically.</description>
    </key>
  </schema>
</schemalist>
